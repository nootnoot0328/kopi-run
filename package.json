{
  "name": "kopi-run",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "test": "node --test",
    "test:browser": "node scripts/verify-mobile.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply kopi-run --local",
    "db:remote": "wrangler d1 migrations apply kopi-run --remote",
    "team-link": "node scripts/team-link.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261019.1-beta",
    "playwright": "1.64.1",
    "wrangler": "4.151.3"
  }
}
